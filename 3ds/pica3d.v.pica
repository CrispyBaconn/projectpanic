; Panic Park (3DS): 3D vertex shader (platform/pica3d.h). Vertices arrive already in homogeneous coordinates
; (x*w, y*w, z*w, w in top-screen pixels): the screen's rotated orthographic projection is enough.
; The colour arrives as bytes 0..255 (polygon light already divided by 4: the combiner multiplies by 4).

.fvec projection[4]

.constf myconst(0.0, 1.0, 0.00392156862745, 0.0)
.alias  inv255 myconst.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	dp4 outpos.x, projection[0], inpos
	dp4 outpos.y, projection[1], inpos
	dp4 outpos.z, projection[2], inpos
	dp4 outpos.w, projection[3], inpos
	mov outtc0, intex
	mul outclr, inv255, inclr
	end
.end
