#---------------------------------------------------------------------------------
# Panic Park ricompilato -> Nintendo 3DS (New 3DS / New 2DS XL), file .3dsx
# Derivato dal template ufficiale di devkitPro (3ds-examples/graphics/gpu).
#
# Requisiti (WSL/Linux con devkitPro):  sudo dkp-pacman -S 3ds-dev        (devkitARM, libctru, citro3d, citro2d)
# Uso (dalla cartella recomp/):         make -f Makefile.3ds -j$(nproc)   oppure  sh platform/build_3ds.sh
# Risultato: panicprk.3dsx -> sd:/3ds/panicprk.3dsx (i file del gioco in sd:/3ds/panicprk/, vedi README_3DS.md)
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Imposta DEVKITARM: export DEVKITARM=$$DEVKITPRO/devkitARM")
endif

TOPDIR ?= $(CURDIR)
include $(DEVKITARM)/3ds_rules

TARGET      := panicprk
BUILD       := build_3ds
SOURCES     := gen_full platform 3ds
DATA        :=
INCLUDES    := . gen_full platform

APP_TITLE       := Panic Park (recomp)
APP_DESCRIPTION := Namco System 23 - ricompilazione statica
APP_AUTHOR      := recomp
ICON            :=

# cartella dell'app sulla SD (ROM, elf, bin, assets/, lang/, ui/, nvram.bin, panicprk.ini, log.txt)
S3DS_DIR ?= sdmc:/3ds/panicprk
OPT      ?= -O2

ARCH     := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
# -w: il codice generato ha moltissime label inutilizzate
CFLAGS   := -g -w $(OPT) -mword-relocations -ffunction-sections $(ARCH)
CFLAGS   += $(INCLUDE) -D__3DS__ -DS23_POLL_TICK -DS23_3DS_DIR=\"$(S3DS_DIR)\"
CXXFLAGS := $(CFLAGS) -fno-rtti -fno-exceptions -std=gnu++17
ASFLAGS  := -g $(ARCH)
LDFLAGS   = -specs=3dsx.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)

LIBS     := -lcitro2d -lcitro3d -lctru -lm
LIBDIRS  := $(CTRULIB)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT  := $(CURDIR)/$(TARGET)
export TOPDIR  := $(CURDIR)
export VPATH   := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR := $(CURDIR)/$(BUILD)

CPPFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
PICAFILES  := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.v.pica)))

export LD := $(CXX)
export OFILES_SOURCES := $(CPPFILES:.cpp=.o)
export OFILES_BIN     := $(PICAFILES:.v.pica=.shbin.o)
export OFILES         := $(OFILES_BIN) $(OFILES_SOURCES)
export HFILES         := $(PICAFILES:.v.pica=_shbin.h)

export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                   -I$(CURDIR)/$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

export _3DSXDEPS := $(if $(NO_SMDH),,$(OUTPUT).smdh)
ifneq (,$(wildcard $(TOPDIR)/3ds/icon.png))
	export APP_ICON := $(TOPDIR)/3ds/icon.png
endif
ifeq ($(strip $(NO_SMDH)),)
	export _3DSXFLAGS += --smdh=$(CURDIR)/$(TARGET).smdh
endif

.PHONY: all clean

all: $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.3ds

$(BUILD):
	@mkdir -p $@

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(TARGET).3dsx $(OUTPUT).smdh $(TARGET).elf

#---------------------------------------------------------------------------------
else

$(OUTPUT).3dsx : $(OUTPUT).elf $(_3DSXDEPS)
$(OFILES_SOURCES) : $(HFILES)
$(OUTPUT).elf : $(OFILES)

.PRECIOUS : %.shbin
%.shbin.o %_shbin.h : %.shbin
	$(SILENTMSG) $(notdir $<)
	$(bin2o)

-include $(DEPSDIR)/*.d

endif
#---------------------------------------------------------------------------------
